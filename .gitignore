# ==========================
# Transactly Git Ignore File
# ==========================

#################################
# PYTHON BACKEND (.gitignore)
#################################

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.pyd

# --- IDE & Editor Files ---
.vscode/
.idea/
.DS_Store

# --- OS generated files ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Python cache & logs ---
*.log
*.out
*.err
*.egg-info/
*.egg
.cache/
.tox/
.mypy_cache/
.pytest_cache/
coverage/
htmlcov/
build/
dist/

# --- Model & Embeddings ---
# (Optional: comment out if you want to commit models)
#app/models/*.pkl
data/processed/embeddings.npy
data/processed/texts.npy

# --- Raw & Synthetic Data ---
data/raw/
data/feedback.csv
data/processed/transactions_retrained.csv

# --- Local development artifacts ---
notebooks/
*.ipynb_checkpoints/
*.swp

# --- Streamlit / Render temp ---
.streamlit/


#################################
# NODE / NEXT.JS FRONTEND (.gitignore)
#################################

# --- Node Modules ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.lockb

# --- Build Output ---
.next/
out/
dist/
build/

# --- Environment Files ---
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# --- Log Files ---
*.log
logs/

# --- Temp Files ---
*.tmp
*.temp
.tmp/
temp/
*.swp

# --- OS / Editor (overlap) ---
.DS_Store
Thumbs.db

# --- Next.js Specific ---
# Static export output
.next/
out/

# TailwindCSS cache
.tailwind/
.stylelintrc.json

# --- Vercel Deployment ---
.vercel/

# --- Yarn / PNPM ---
.yarn/*
.pnp.*
.pnpm-store/
.cache/

#################################
# GENERAL PROJECT CLEANUP
#################################

# Local backups
*.bak
*.orig

# Local lock files (choose one depending on package manager)
package-lock.json
yarn.lock
pnpm-lock.yaml